# Скопируйте в .env при необходимости. Значения подхватывает `datanorma.config.Settings` (pydantic-settings)
# из окружения и из этого файла в рабочей директории процесса.
# Для локального Docker дефолт в коде совпадает с docker-compose.
DATABASE_URL=postgresql+psycopg://datanorma:datanorma@127.0.0.1:5433/datanorma

# Веб-UI и JWT (python -m datanorma.web). В production обязательны секрет и явные CORS origin.
# DATANORMA_ENVIRONMENT=development
# DATANORMA_JWT_SECRET=
# DATANORMA_JWT_EXPIRE_HOURS=24
# Список origin через запятую (в production обязателен; нельзя * при credentials)
# DATANORMA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Ссылка на Dagster UI для экрана «операционная консоль»
# DATANORMA_DAGSTER_UI_URL=http://127.0.0.1:3000

# Имя таблицы для типизированного/нормализованного слоя (по умолчанию normalized)
# DATANORMA_WAREHOUSE_TABLE=normalized

# Только для отката к старому поведению: CREATE TABLE из SQLAlchemy без Alembic (схема может разъехаться)
# DATANORMA_AUTO_CREATE_TABLES=1

# Необязательно: если код установлен не в editable-режиме, укажите корень репозитория с папкой data/samples
# DATANORMA_REPO_ROOT=C:\dev\diploma\diploma

# Пользовательские stream-rules задаются через API /api/v1/connections/*/streams/*/rules

# Google Sheets: service account JSON + id таблицы (иначе — data/samples/google_sheet_export.csv)
# GSPREAD_SERVICE_ACCOUNT_FILE=
# GSPREAD_SPREADSHEET_ID=
# GSPREAD_WORKSHEET=0

# Google OAuth (UI «Подключить Google»): client_secret JSON из Google Cloud Console
# Скопируйте config/secrets/google_oauth_client.json.example → google_oauth_client.json
# DATANORMA_GOOGLE_OAUTH_CLIENT_FILE=config/secrets/google_oauth_client.json
# Redirect URI в Google Console (тип Web):
#   http://127.0.0.1:8080/api/v1/integrations/google/oauth/callback
# DATANORMA_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/integrations/google/oauth/callback
# Базовый origin SPA после OAuth (путь с hash подставляется из UI, например /#/connections/new):
# DATANORMA_GOOGLE_OAUTH_FRONTEND_RETURN_URL=http://127.0.0.1:5173
# Открывайте UI с тем же host, что в return (localhost vs 127.0.0.1 — разные localStorage).

# Яндекс Метрика: OAuth-токен и ID счётчика для check() через Management API (иначе — data/samples/yandex_metrika_*.json)
# YANDEX_METRIKA_OAUTH_TOKEN=
# YANDEX_METRIKA_COUNTER_ID=
