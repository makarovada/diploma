# Скопируйте в .env при необходимости; для локального Docker дефолт в коде совпадает с docker-compose.
DATABASE_URL=postgresql+psycopg://datanorma:datanorma@127.0.0.1:5433/datanorma

# Веб-UI и JWT (python -m datanorma.web). В проде задать длинный секрет.
# DATANORMA_JWT_SECRET=
# DATANORMA_JWT_EXPIRE_HOURS=24
# Ссылка на Dagster UI для экрана «операционная консоль»
# DATANORMA_DAGSTER_UI_URL=http://127.0.0.1:3000

# Имя таблицы витрины (по умолчанию canonical_sales)
# DATANORMA_WAREHOUSE_TABLE=canonical_sales

# Только для отката к старому поведению: CREATE TABLE из SQLAlchemy без Alembic (схема может разъехаться)
# DATANORMA_AUTO_CREATE_TABLES=1

# Необязательно: если код установлен не в editable-режиме, укажите корень репозитория с папкой data/samples
# DATANORMA_REPO_ROOT=C:\dev\diploma\diploma

# Свой маппинг источников → каноническая схема (копия datanorma/schemas/source_mappings.yaml)
# DATANORMA_SOURCE_MAPPINGS_PATH=

# Ozon Seller API (иначе — data/samples/ozon_postings.json)
# OZON_CLIENT_ID=
# OZON_API_KEY=
# OZON_FETCH_LIMIT=100

# 1С: путь к CSV/XLSX выгрузке (иначе — data/samples/1c_export.csv)
# DATANORMA_1C_EXPORT_PATH=

# Google Sheets: service account JSON + id таблицы (иначе — data/samples/google_sheet_export.csv)
# GSPREAD_SERVICE_ACCOUNT_FILE=
# GSPREAD_SPREADSHEET_ID=
# GSPREAD_WORKSHEET=0
